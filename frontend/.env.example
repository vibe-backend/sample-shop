# mock (default): in-memory/localStorage data, no backend needed
# real: calls the backend at VITE_API_BASE_URL
VITE_API_MODE=mock
# /api or http://localhost:8080 both resolve to /api/<definition>/v1/...
# A trailing /api is normalized so requests never duplicate /api/api.
VITE_API_BASE_URL=/api
VITE_SHOP_SLUG=main
