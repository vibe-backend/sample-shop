{
  // Tests run only on Node 22 (vitest), so they may use ES2022 APIs such as Array.prototype.at.
  // App code stays on ES2020 (tsconfig.json) because Vite 5's default build target
  // (chrome87/edge88/firefox78/safari14) does not polyfill them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020", "ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "build-env.ts", "build-env.test.ts"],
  "exclude": []
}
